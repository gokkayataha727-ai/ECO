{
  "name": "eco-coffee-pos",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "tsc -b && vite build && electron-builder --win --publish never",
    "electron:build:dir": "tsc -b && vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "terser": "^5.31.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.ecocoffee.pos",
    "productName": "LEMOON KAFE POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEMOON KAFE POS",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "uninstallDisplayName": "LEMOON KAFE POS (Kaldır)",
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.png"
    }
  }
}
