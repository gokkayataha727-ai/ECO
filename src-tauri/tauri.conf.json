{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Eco Coffee POS",
  "version": "1.0.6",
  "identifier": "com.ecocoffee.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ECO COFFEE - Kasa & Restoran Otomasyonu",
        "label": "main",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "width": 1920,
        "height": 1080,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Turkish", "English"],
        "shortDescription": "ECO COFFEE POS - Kasa ve Restoran Otomasyonu",
        "headerImage": null,
        "sidebarImage": null
      }
    },
    "resources": []
  },
  "plugins": {
    "autostart": {
      "macOSExtraArgs": [],
      "args": ["--autostart"]
    },
    "fs": {
      "scope": {
        "allow": [
          "$APPDATA/**",
          "$RESOURCE/**"
        ]
      }
    }
  }
}
